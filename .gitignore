# профили ИИ-провайдеров — содержит API-ключи, в гит НЕЛЬЗЯ
ai_config.json
# кэш каталога моделей (models.dev) — рядом с ai_config.json, у изолированного
# профиля свой (models_dev.test.json)
models_dev*.json
*_models_dev.json
# кэш каталога OpenRouter (supported_efforts/default_enabled) — рядом с ai_config.json,
# у изолированного профиля свой (имя производное от конфига)
*_openrouter_models.json
# лог ИИ-вызовов: токены по шагам (REELSI_AI_LOG), своя копия для тестового профиля
ai_calls.jsonl
ai_calls.test.json
# самообучающийся словарик фраз-галлюцинаций Omni (локальные данные)
halluc_phrases.json
# словарь трудных терминов (названия, которых не знает ASR) — правится из UI, у каждого свой
terms.json
terms.test.json
# свои списки цензуры (⚙ → «Слова»): у каждого канала свои стоп-слова.
# Общие списки badwords.txt/okwords.txt остаются в репозитории
badwords.user.txt
okwords.user.txt
